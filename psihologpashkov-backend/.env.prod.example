APP_NAME=Psiholog Pashkov API
APP_ENV=prod
API_V1_PREFIX=/api/v1

API_DOMAIN=api.psihologpashkov.ru

CORS_ORIGINS=https://psihologpashkov.ru,https://www.psihologpashkov.ru

POSTGRES_DB=psihologpashkov
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-postgres-password

DATABASE_URL=postgresql+asyncpg://postgres:change-me-strong-postgres-password@postgres:5432/psihologpashkov

JWT_ACCESS_SECRET=change-me-random-access-secret-minimum-32-bytes
JWT_REFRESH_SECRET=change-me-random-refresh-secret-minimum-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_DOMAIN=.psihologpashkov.ru
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=lax

CACHE_DEFAULT_TTL_SECONDS=300

UPLOADS_ROOT=backend/uploads
UPLOADS_PUBLIC_PATH=/uploads
AVATAR_UPLOAD_SUBDIR=avatars
AVATAR_MAX_SIZE_BYTES=2097152
AVATAR_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp

ENABLE_OPENAPI=false

CORS_ORIGINS=https://psihologpashkov.ru,https://www.psihologpashkov.ru,http://127.0.0.1:5500,http://localhost:5500

EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
EMAIL_VERIFICATION_LINK_BASE_URL=https://psihologpashkov.ru/lk

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=no-reply@psihologpashkov.ru
SMTP_FROM_NAME=Psiholog Pashkov
SMTP_USE_TLS=true
SMTP_USE_SSL=false